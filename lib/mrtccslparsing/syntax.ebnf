<addsub> ::= PLUS
           | MINUS

<binop> ::= PLUS
          | MINUS
          | STAR
          | SLASH

<num_rel> ::= LESS
            | LESSEQ
            | EQUAL
            | MORE
            | MOREEQ
            | NOTEQUAL

<var_type> ::= INTEGER
             | DURATION
             | CLOCK

<dangling_list(sep, X)> ::= [<non_empty_dangling_list(sep, X)>]

<non_empty_dangling_list(sep, X)> ::= X [sep]
                                    | X sep <non_empty_dangling_list(sep, X)>

<located(X)> ::= X

<id> ::= ID

<path> ::= ID (DOT ID)*

<var> ::= <located(<path>)>

<percentage> ::= DECIMAL PERCENT

<duration> ::= DECIMAL SECOND
             | INT SECOND

<interval(X)> ::= LBRACKET X COMMA X RBRACKET
                | RBRACKET X COMMA X RBRACKET
                | LBRACKET X COMMA X LBRACKET
                | RBRACKET X COMMA X LBRACKET

<numeric_interval(X)> ::= <interval(X)>
                        | X PLUSMINUS X

<clock_rel> ::= COINCIDENCE
              | SHARP
              | [STRICT] ALTERNATES
              | SUBCLOCKS [LBRACKET <percentage> RBRACKET]
              | PRECEDES
              | CAUSES

<contdist> ::= <located(<contdist0>)>

<contdist0> ::= NORMAL LPAREN <duration> COMMA <duration> RPAREN
              | UNIFORM
              | EXPONENTIAL LPAREN <duration> RPAREN
              | HISTOGRAM LPAREN <duration> RPAREN

<duration_expr> ::= <duration_expr0>

<delim_duration_expr0> ::= LPAREN <duration_expr0> RPAREN
                         | <var>
                         | <duration>

<delim_duration_expr> ::= <delim_duration_expr0>

<duration_expr0> ::= <delim_duration_expr0>
                   | <duration_expr> <addsub> <duration_expr>
                   | DECIMAL STAR <delim_duration_expr>
                   | MINUS <delim_duration_expr>
                   | QUESTION

<int_expr> ::= <int_expr0>

<int_expr0> ::= INT
              | <var>
              | <int_expr> <binop> <int_expr>
              | MINUS <int_expr>
              | QUESTION

<inline_relation(X)> ::= X
                       | <numeric_interval(X)>

<offset> ::= OFFSET <duration_expr>

<skip> ::= SKIP <inline_relation(<int_expr>)>

<clock_expr> ::= <clock_expr0>

<delim_clock_expr0> ::= LPAREN <clock_expr0> RPAREN
                      | <var>

<delim_clock_expr> ::= <delim_clock_expr0>

<clock_expr0> ::= <delim_clock_expr0>
                | <delim_clock_expr> (AND <delim_clock_expr>)+
                | <delim_clock_expr> (OR <delim_clock_expr>)+
                | <delim_clock_expr> (XOR <delim_clock_expr>)+ [LBRACKET
                  <var> RBRACKET]
                | <delim_clock_expr> DOLLAR <inline_relation(<int_expr>)> [ON
                  <delim_clock_expr>]
                | NEXT <delim_clock_expr>
                | [<skip>] EVERY <located(INT)> WITH JITTER
                  <inline_relation(<int_expr>)> OF <delim_clock_expr>
                | SAMPLE <delim_clock_expr> ON <delim_clock_expr>
                | FIRST SAMPLE <delim_clock_expr> ON <delim_clock_expr>
                | LAST SAMPLE <delim_clock_expr> ON <delim_clock_expr>
                | <delim_clock_expr> EXCEPT <delim_clock_expr>+
                | FASTEST OF <delim_clock_expr>+
                | SLOWEST OF <delim_clock_expr>+
                | PERIODIC <duration> WITH JITTER
                  <inline_relation(<duration_expr>)> [<offset>]
                | PERIODIC <duration> WITH DRIFT
                  <inline_relation(<duration_expr>)> [<offset>]
                | DELAY <delim_clock_expr> BY
                  <inline_relation(<duration_expr>)>
                | [STRICT] SPORADIC <duration>

<additive_union> ::= OR_EQ
                   | XOR_EQ

<statement> ::= <statement0>

<statement0> ::= VAR (<id> (COMMA <id>)* COLON <var_type> (COMMA <id> (COMMA
                 <id>)* COLON <var_type>)*)
               | INTEGER COLON <int_expr> (<num_rel> <int_expr>)+
               | DURATION COLON <duration_expr> (<num_rel> <duration_expr>)+
               | <clock_expr> <clock_rel> <clock_expr>
               | CONTINUOUS PROCESS <var> WITH <contdist>
               | DISCRETE PROCESS <var> WITH <located(INT+)> SIM <located(INT
                 (COLON INT)*)>
               | MUTEX LBRACE <dangling_list(COMMA, <clock_expr> ARROWRIGHT
                 <clock_expr>)> RBRACE
               | POOL INT LBRACE <dangling_list(COMMA, <clock_expr>
                 ARROWRIGHT <clock_expr>)> RBRACE
               | ALLOW <clock_expr>+ IN <interval(<clock_expr>)>
               | FORBID <clock_expr>+ IN <interval(<clock_expr>)>
               | <id> LBRACE <statements> RBRACE
               | <var> <additive_union> <clock_expr>

<statements> ::= <dangling_list(SEMICOLON, <statement>)>

<mod_block(NAME)> ::= NAME LBRACE <statements> RBRACE

<top_module> ::= <mod_block(ASSUME)>* <mod_block(STRUCTURE)>
                 <mod_block(ASSERT)>* EOF


